// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bagIngredients     BagIngredient[]
  recipeIngredientState RecipeIngredientState[]
  dailyPlanSettings  DailyPlanSettings?
  dailyLogs          DailyLog[]
  exerciseSchedules  ExerciseSchedule[]
  exerciseLogs       ExerciseLog[]
  subscriptions      Subscription[]
  car                Car?
  accounts           Account[]
  sessions           Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Recipe {
  id String @id @default(cuid())
  slug String @unique
  title String
  serves Int
  categoryId String @default("food")
  thumbnail String?
  instructions String?
  video String?
  link String?
  category RecipeCategory @relation(fields: [categoryId], references: [id])
  gallery Image[]
  tags Tag[]
  ingredients RecipeIngredient[]
  recipeIngredientStates RecipeIngredientState[]
}

model Ingredient {
  id String @id @default(cuid())
  name String
  image String
  caloriesPer100g Float?
  proteinPer100g Float?
  carbsPer100g Float?
  fatPer100g Float?
  recipeIngredients RecipeIngredient[]
  bagIngredients BagIngredient[]
}

model RecipeIngredient {
  id String @id @default(cuid())
  recipeId String
  ingredientId String
  unitId String
  amount Float?
  instruction String?
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  unit MeasurementUnit @relation(fields: [unitId], references: [id])
}

model MeasurementUnit {
  id String @id @default(cuid())
  name String
  plural String
  recipeIngredients RecipeIngredient[]
  bagIngredients BagIngredient[]
}

model Tag {
  id String @id @default(cuid())
  name String @unique
  recipes Recipe[]
}

model Image {
  id String @id @default(cuid())
  name String
  url String
  recipes Recipe[]
}

model RecipeIngredientState {
  recipeId String
  userId String
  user User @relation(fields: [userId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  serves Int?
  state String?

  @@unique(fields: [recipeId, userId], name: "id")
}

model BagIngredient {
  userId String
  ingredientId String
  unitId String
  amount Float?
  note String?
  order Int @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  unit MeasurementUnit @relation(fields: [unitId], references: [id])

  @@id(name: "bagIngredientId", [userId, ingredientId, unitId])
}

model RecipeCategory {
  id      String   @id
  name    String
  recipes Recipe[]
}

model DailyPlanSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waterTargetL        Float    @default(3.0)
  creatineTargetG     Float    @default(5.0)
  calorieTarget       Int      @default(2500)
  sprintCount         Int      @default(8)
  sprintFrequencyDays Int      @default(2)
  pullupWeightKg      Float    @default(10.0)
  pullupSets          Int      @default(4)
  pullupRepsPerSet    Int      @default(6)
  pullupFrequencyDays Int      @default(3)
  dipWeightKg         Float    @default(10.0)
  dipSets             Int      @default(4)
  dipRepsPerSet       Int      @default(8)
  dipFrequencyDays    Int      @default(3)
  sprintStartDate     DateTime?
  pullupStartDate     DateTime?
  dipStartDate        DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model DailyLog {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  waterConsumedL  Float          @default(0)
  waterTargetL    Float
  creatineDone    Boolean        @default(false)
  creatineTargetG Float
  calorieTarget   Int
  weightKg        Float?
  calorieEntries  CalorieEntry[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, date])
}

model CalorieEntry {
  id         String   @id @default(cuid())
  dailyLogId String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  amount     Int
  label      String?
  createdAt  DateTime @default(now())
}

model ExerciseSchedule {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseType  String
  scheduledDate DateTime
  exerciseLog   ExerciseLog?

  @@unique([userId, exerciseType, scheduledDate])
}

model ExerciseLog {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId        String           @unique
  schedule          ExerciseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  exerciseType      String
  date              DateTime
  sprintsDone       Int?
  sprintsPlanned    Int?
  setResults        Json?
  weightKgUsed      Float?
  weightKgPlanned   Float?
  setsPlanned       Int?
  repsPerSetPlanned Int?
  notes             String?
  fullyCompleted    Boolean          @default(false)
  progressionApplied String?
  createdAt         DateTime         @default(now())
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  periodicity String
  image       String?
  order       Int      @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Car {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  licensePlate  String?
  model         String?
  year          Int?
  image         String?
  pzpExpiry     DateTime?
  pzpLink       String?
  havarijExpiry DateTime?
  havarijLink   String?
  stkExpiry     DateTime?
  stkLink       String?
  ekExpiry      DateTime?
  ekLink        String?
  highwayPasses HighwayPass[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model HighwayPass {
  id        String    @id @default(cuid())
  carId     String
  car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  country   String
  expiry    DateTime?
  link      String?
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}